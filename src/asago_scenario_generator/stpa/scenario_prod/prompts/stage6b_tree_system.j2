    label: "WHY THE UCA OCCURS"
    children:
      - label: "Process-model divergence"
        children:
          - label: "Process-model state diverges through FB-1-1"
            details: "FB-1-1 supplies stale state, leaving PM-1-1 inaccurate"
  - category: "path_side"
