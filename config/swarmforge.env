# Portable SwarmForge project configuration.
#
# This file defines project-owned commands and paths only. Agent harness state,
# role prompts, and upstream tool checkouts are intentionally external.
SWARMFORGE_FEATURES_DIR="features"
SWARMFORGE_ACCEPTANCE_IR_DIR="build/acceptance/ir"
SWARMFORGE_ACCEPTANCE_DRY_DIR="build/acceptance/dry"
SWARMFORGE_ACCEPTANCE_GENERATED_DIR="build/acceptance/generated"
SWARMFORGE_ACCEPTANCE_MUTATION_DIR="build/acceptance-mutation"
SWARMFORGE_GENERATION_CMD="./scripts/acceptance.sh"
SWARMFORGE_FILE_POLICY="generated-output"

SWARMFORGE_TEST_CMD="./scripts/acceptance.sh && uv run pytest tests/ -x"
SWARMFORGE_ACCEPTANCE_CMD="./scripts/acceptance.sh"
SWARMFORGE_QUALITY_CMD="./scripts/quality.sh"
SWARMFORGE_COVERAGE_CMD="./scripts/acceptance.sh && uv run pytest tests/ --cov=src --cov-branch --cov-report=lcov:lcov.info -q"
SWARMFORGE_CRAP_CMD="crap4py src/ --lcov lcov.info --max-crap 6"
SWARMFORGE_DRY_CMD="drywall --threshold 0.82 ./src"
SWARMFORGE_MUTATION_CMD="mutate4py src/ --since-last-run --test-command 'uv run pytest tests/ -x -q' --lcov lcov.info --max-workers 8 --verbose"

SWARMFORGE_UPSTREAM_REPOSITORY="https://github.com/unclebob/swarm-forge"
SWARMFORGE_UPSTREAM_PACK="six-pack"
SWARMFORGE_UPSTREAM_PACK_REVISION="59803dadb38e0e09d5357d749452036e4a82ae60"
SWARMFORGE_UPSTREAM_SCRIPTS_REVISION="9acd54d2239fef7e41ddacd8fd30dfb0e69672fe"
SWARMFORGE_APS_REPOSITORY="https://github.com/unclebob/Acceptance-Pipeline-Specification"
SWARMFORGE_APS_REVISION="accaa33d503340c56513ef387258f8da929ba902"
SWARMFORGE_CRAP_REPOSITORY="https://github.com/gabadi/crap4py"
SWARMFORGE_CRAP_REVISION="42c8be1939641f2e09fb0afae058b4bce46346dd"
SWARMFORGE_DRY_REPOSITORY="https://github.com/gabadi/drywall"
SWARMFORGE_DRY_REVISION="ad7cf43907ced63bb3f4b3d134d51f54376a5a5d"
SWARMFORGE_MUTATION_REPOSITORY="https://github.com/gabadi/mutate4py"
SWARMFORGE_MUTATION_REVISION="87757ef6c4af5bb8d681692e7af6306b18a721f0"
